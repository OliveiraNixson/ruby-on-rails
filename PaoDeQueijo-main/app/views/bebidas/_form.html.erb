<div class='w-full min-h-screen m-auto max-w-lg mb-4'>
    <%= simple_form_for @bebida, html: {class:'bg-white rounded px-8 pt-6 pb-8 mb-4'} do  |f|%>
        <div class='p-4'>
            <div class=''>
                <%= f.input :name, label: 'Nome da Bebida', input_html:{class: 'shadow appearense-none rounded w-full py-2 px-2 text-gray-700'}%>
            </div>
            <div class='mt-6'>
                <%= f.input :price, label: 'Preço da bebida', input_html:{min: 0,step: 0.5, autofocus: true , class: 'shadow appearense-none rounded w-full py-2 px-2 text-gray-700'} %>
            </div>
            <div class='mt-6'>
                <%= f.input :volume, label: 'Volume de Liquido', input_html:{min: 0, step: 0.5, autofocus: true, class: 'shadow appearense-none rounded w-full py-2 px-2 text-gray-700'}%>
            </div>
            <div class=''>
                <%= f.submit  class: 'w-full text-center text-white bg-blue-600 transition ease-in-out hover:bg-blue-500 rounded p-4 mt-4 cursor-pointer'%>
            </div>
        </div>
    <% end %> 
</div>