<div class='w-full min-h-screen m-auto max-w-lg mb-4'>
    <%= simple_form_for @salgado, html: {class:'bg-white rounded px-8 pt-6 pb-8 mb-4'} do  |f|%>
        <div class='p-4'>
            <div class=''>
                <%= f.input :name, label: 'Nome do Salgado', input_html:{class: 'shadow appearense-none rounded w-full py-2 px-2 text-gray-700'}%>
            </div>
            <div class='mt-6'>
                <%= f.input :price, label: 'Preço do Salgado', input_html:{min: 0,step: 0.5, autofocus: true , class: 'shadow appearense-none rounded w-full py-2 px-2 text-gray-700'} %>
            </div>
            <div class='mt-6'>
                <%= f.input :mass, label: 'Massa do Salgado', input_html:{ autofocus: true, class: 'shadow appearense-none rounded w-full py-2 px-2 text-gray-700'}%>
            </div>
            
            <%= f.submit class: 'w-full text-center text-white bg-blue-600 transition ease-in-out hover:bg-blue-500 rounded p-4 mt-4'%>
            
        </div>
    <% end %> 
</div>