<%= turbo_stream_from current_company, "quotes" %>
<main id="container" class="w-full min-h-screen bg-gray-100 py-10 px-6">  
  <div class="max-w-5xl mx-auto">

    <%= turbo_frame_tag "first_turbo_frame" do %>
    <div class="flex items-center justify-between mb-8">
      <h1 class="text-3xl font-bold text-gray-800">
        Quotes
      </h1>

      <%= link_to "New Quote",
          new_quote_path,
          data: {turbo_frame:"new_quote"},
          class: "bg-blue-600 hover:bg-blue-700 text-white font-medium px-5 py-2 rounded-xl shadow-md transition duration-300 ease-in-out transform hover:scale-105" %>
    </div>
    <% end %>

    <!-- Quotes Grid -->
    <%= turbo_frame_tag "new_quote" %> 
      <%= turbo_frame_tag "quotes", class:"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" do %>
        <%= render @quotes %>
      <% end %>
  </div>

</main>
