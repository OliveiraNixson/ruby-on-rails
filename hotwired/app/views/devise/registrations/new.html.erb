<main class="w-full min-h-screen flex items-center justify-center bg-gray-100 px-4">
  <div class="w-full max-w-md bg-white shadow-xl rounded-2xl p-8">

    <h2 class="text-3xl font-bold text-center text-gray-800 mb-4">
      Criar conta
    </h2>

    <p class="text-center text-gray-500 mb-8">
      Comece a usar a plataforma em segundos
    </p>

    <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      
      <%= f.error_notification %>

      <div class="space-y-4">

        <%= f.input :email,
            required: true,
            label: "Email",
            autofocus: true,
            input_html: {
              autocomplete: "email",
              class: "w-full rounded-lg border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            } %>

        <%= f.input :password,
            required: true,
            label: "Senha",
            hint: ("#{@minimum_password_length} caracteres mínimo" if @minimum_password_length),
            input_html: {
              autocomplete: "new-password",
              class: "w-full rounded-lg border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            } %>

        <%= f.input :password_confirmation,
            required: true,
            label: "Confirmar senha",
            input_html: {
              autocomplete: "new-password",
              class: "w-full rounded-lg border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            } %>

      </div>

      <div class="mt-6">
        <%= f.button :submit, "Criar conta",
          class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-lg transition duration-200" %>
      </div>

    <% end %>

    <div class="mt-6 text-center text-sm text-gray-500">
      <%= render "devise/shared/links" %>
    </div>

  </div>
</main>