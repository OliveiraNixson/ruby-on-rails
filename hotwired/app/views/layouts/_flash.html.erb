<div id="flash-container"
     class="fixed top-5 right-5 z-50 space-y-3 w-80">

  <% flash.each do |type, message| %>
    <div data-controller="flash"
         class="flash flex items-center justify-between px-4 py-3 rounded-lg shadow-lg text-white
                transform transition-all duration-300 ease-out
                translate-y-[-20px] opacity-0
                <%= flash_class(type) %>">

      <span><%= message %></span>

      <button data-action="click->removals#remove"
              class="ml-4 text-xl leading-none hover:opacity-70">
        ×
      </button>
    </div>
  <% end %>
</div>