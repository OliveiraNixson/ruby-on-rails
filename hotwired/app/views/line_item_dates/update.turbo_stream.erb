<%= turbo_stream.replace "line_item_date_#{@line_item_date.id}" %>
<%= turbo_stream.prepend "line_item_dates" do %>
    <%= render partial:"line_item_dates/line_item_date", locals:{ line_item_date: @line_item_date, quote: @quote }%>
<% end %>
<%= turbo_stream.prepend "flash", partial: "layouts/flash" %>