<%= simple_form_for [quote, line_item_date], html: { } do |f| %>

  <% if line_item_date.errors.any? %>
    <div class="bg-red-100 text-red-700 p-3 rounded">
      <%= line_item_date.errors.full_messages.to_sentence.capitalize %>
    </div>
  <% end %>

  <div>
    <%= f.date_field :date, as: :date,
      input_html: { class: "w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" },
      label_html: { class: "block text-sm font-medium text-gray-700 mb-1" }
    %>
  </div>

  <div class="flex justify-between items-center pt-4">
    <div class="">
    <%= link_to "Cancel", quote_path(quote), 
      class: "text-gray-500 hover:text-gray-700 transition" %>

    <%= f.submit "Save", 
      class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded transition" %>
    </div>
  </div>

<% end %>