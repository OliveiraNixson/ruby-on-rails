<%= turbo_frame_tag "line_item_#{line_item.id}" do %>
  <div class="flex flex-col border-b border-gray-100">
    <div class="flex items-start justify-between  py-4 gap-4">

      <!-- Nome + descrição -->
      <div class="flex flex-col">
        <h2 class="font-semibold text-gray-900">
          Name
        </h2>
        <div class="text-gray-500">
          <%= line_item.name %>
        </div>
        
      </div>

      <!-- Quantidade -->
      <div class="flex flex-col">
        <h2 class="font-semibold text-gray-900">
          Quantity
        </h2>
        <div class="text-sm text-gray-500 w-12 text-center">
          <%= line_item.quantity %>
        </div>
      </div>

      <!-- Preço -->
      <div class="flex flex-col">
        <h2 class="font-semibold text-gray-900">
          Quantity
        </h2>
        <div class="text-sm text-gray-500 w-24">
          <%= number_to_currency line_item.unit_price %>
        </div>
      </div>

      <!-- Ações -->
      <div class="flex gap-2">
        <%= button_to "Delete",
                      [quote, line_item_date, line_item],
                      method: :delete,
                      data: { turbo_confirm: "Are you sure?" } ,
                      class: "px-3 py-1.5 text-sm border border-gray-300 rounded-md text-gray-700 hover:bg-gray-100" %>

        <%= link_to "Edit",
                    [:edit, quote, line_item_date, line_item],
                    class: "px-3 py-1.5 text-sm border border-gray-300 rounded-md text-gray-700 hover:bg-gray-100" %>
      </div>

    </div>
    <div class="text-sm text-gray-600 mt-1">
      <%= simple_format line_item.description %>
    </div>
  </div>
<% end %>