<%= turbo_stream.append "line_item_date_#{@line_item_date.id}_line_items" do %>
    <%= render partial: "line_items/line_item", locals:{quote: @quote, line_item_date: @line_item_date, line_item: @line_item}%>
<% end %>
<%= turbo_stream.update  "line_item_date_#{@line_item_date.id}_new_line_item", "" %>
<%= turbo_stream.append "flash", partial: "layouts/flash" %>
<%= turbo_stream.update dom_id(@quote, :total) do %>
    <%= render "quotes/total", quote: @quote %>
<% end %>