<main class="min-h-screen w-full flex items-center justify-center bg-gray-100 px-6">
  <div class="w-full text-center bg-white shadow-lg rounded-2xl p-10">
    
    <h1 class="text-4xl font-bold text-gray-800 mb-4">
      Quote Editor
    </h1>
    
    <p class="text-gray-500 mb-8">
      A blazing fast quote editor built with Hotwire
    </p>

    <% if user_signed_in? %>
      <%= link_to "View Quotes", quotes_path,
        class: "inline-block bg-blue-600 hover:bg-blue-700 text-white font-medium px-6 py-3 rounded-lg transition" %>
    <% else %>
      <%= link_to "Sign In", new_user_session_path,
        class: "inline-block bg-gray-800 hover:bg-gray-900 text-white font-medium px-6 py-3 rounded-lg transition" %>
    <% end %>

  </div>
</main>